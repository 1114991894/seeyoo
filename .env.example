# ============================================
# 肾小友 - 环境变量配置
# ============================================

# --- GitHub OAuth 配置（必需） ---
# 1. 访问 https://github.com/settings/developers
# 2. 点击 "New OAuth App"
# 3. 填写：
#    Application name: 肾小友社区
#    Homepage URL: http://localhost:3015
#    Authorization callback URL: http://localhost:3001/auth/github/callback
# 4. 创建后将 Client ID 和 Client Secret 填入下方
GITHUB_CLIENT_ID=你的_GitHub_Client_ID
GITHUB_CLIENT_SECRET=你的_GitHub_Client_Secret

# --- 认证服务器配置 ---
# 认证服务器监听端口（默认 3001）
AUTH_SERVER_PORT=3001

# 前端地址（开发环境默认 http://localhost:3015）
# 生产环境改为实际域名，例如 https://seeyoo.vip
FRONTEND_URL=http://localhost:3015

# --- (可选) Supabase 配置 ---
# 之前用于手机号/密码登录，现已切换为 GitHub OAuth
# 如果您仍保留 Supabase，可配置环境变量；否则留空即可
# SUPABASE_URL=https://xxxxx.supabase.co
# SUPABASE_ANON_KEY=eyJxxxxx